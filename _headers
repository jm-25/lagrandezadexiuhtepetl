# Cache headers for Cloudflare Pages / Netlify
# Generated by optimize.py — do not edit manually

# Combined bundles: content-hashed filenames → cache forever
/wp-content/combined-*
  Cache-Control: public, max-age=31536000, immutable

# Self-hosted fonts: never change
/wp-content/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Uploaded media: rarely changes on a portfolio site
/wp-content/uploads/*
  Cache-Control: public, max-age=31536000, immutable

# Theme & plugin assets (versioned via ?ver= in HTML)
/wp-content/themes/*
  Cache-Control: public, max-age=31536000, immutable

/wp-content/plugins/*
  Cache-Control: public, max-age=31536000, immutable

# Divi dynamic CSS cache
/wp-content/et-cache/*
  Cache-Control: public, max-age=31536000, immutable

# WordPress core assets
/wp-includes/*
  Cache-Control: public, max-age=31536000, immutable

# HTML pages: short cache so updates are seen quickly
/*.html
  Cache-Control: public, max-age=3600, must-revalidate

/
  Cache-Control: public, max-age=3600, must-revalidate

/project/*
  Cache-Control: public, max-age=3600, must-revalidate
